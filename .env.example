# Copy to .env and fill in real values. .env is git-ignored.
#
# This file is read by two things: `docker compose`, which loads it
# automatically from this directory, and your shell when you run the binary
# directly (`set -a && . ./.env && set +a && go run ./cmd/api`).

# --- API ---------------------------------------------------------------

# Port the HTTP server listens on when running the binary directly. Optional,
# defaults to 8080. Under compose the container always listens on 8080 and
# API_PORT below chooses the host port.
PORT=8080

# Host port compose publishes the API on. Change it if 8080 is taken.
API_PORT=8080

# PostgreSQL connection string used when running the binary on the host.
# Required — the API exits if it is missing or if the connection cannot be
# pinged on startup. Compose ignores this value and builds its own pointing at
# the "db" service, because "localhost" inside the API container is not the
# database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tapago?sslmode=disable

# Secret used to sign and verify JWT access tokens. Required — the API, and
# therefore `docker compose up`, refuses to start without it. Use a long
# random value (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-in-every-environment

# OAuth client ids allowed in the "aud" claim of a Google ID token, comma
# separated — normally one per mobile platform. Optional: leave empty and
# POST /auth/google answers 503. Never widen this to a client id you do not
# own; the audience check is what stops a token minted for another app from
# signing someone in here.
GOOGLE_CLIENT_IDS=

# Apple Services IDs / bundle identifiers allowed in the "aud" claim of an
# Apple ID token, comma separated. Optional, same behaviour as above.
APPLE_CLIENT_IDS=

# Mercado Pago access token, used for every server-to-server call (creating a
# customer, authorising a card). The token itself selects the environment —
# a TEST- prefixed token hits the sandbox, a production one hits production;
# the base URL is the same. Optional: leave empty and the payment routes
# answer 503. This is a secret — never commit a real value.
MERCADOPAGO_ACCESS_TOKEN=

# --- PostgreSQL (docker compose only) ----------------------------------

# Credentials and database name for the compose "db" service. Changing any of
# these after the first `docker compose up` has no effect until the volume is
# recreated (`docker compose down -v`) — postgres only initialises once. Keep
# them in step with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tapago

# Host port the database is published on, so psql and a host-run binary can
# reach it. Change it if you already have PostgreSQL on 5432.
POSTGRES_PORT=5432
